 "learning": {
  "logic_chain": [
   {
    "stage": "assumption",
    "md": "L'impératif n'a pas de sujet exprimé et seulement trois personnes."
   },
   {
    "stage": "mechanism",
    "md": "Formes du présent (sans _s_ final pour _-er_ à _tu_) ; _être, avoir, savoir, vouloir_ prennent les formes du subjonctif."
   },
   {
    "stage": "result",
    "md": "À l'affirmatif, les pronoms suivent le verbe (_moi, toi_) ; au négatif, ils le précèdent."
   }
  ],
  "why_it_matters": "Consignes et conseils à l'impératif sont omniprésents dans les documents authentiques (affiches, notices, articles pratiques).",
  "exam_approach": {
   "look_first": [
    "la personne (tu / nous / vous)",
    "un verbe en _-er_ à la 2e personne",
    "affirmatif ou négatif ?"
   ],
   "traps": [
    "*_manges !_",
    "*_sois patiente_ / _soit patiente_ (orthographe)",
    "*_donne-moi-le_"
   ],
   "distractors": [
    "la forme du présent avec _s_",
    "le pronom mal placé"
   ]
  }
 },
