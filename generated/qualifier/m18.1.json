 "learning": {
  "logic_chain": [
   {
    "stage": "assumption",
    "md": "L'adjectif qualifie un nom et s'accorde ; l'adverbe modifie un verbe et ne s'accorde pas."
   },
   {
    "stage": "mechanism",
    "md": "On forme l'adverbe avec le féminin + _-ment_, ou _-amment / -emment_ pour les adjectifs en _-ant / -ent_."
   },
   {
    "stage": "result",
    "md": "Aux temps composés, l'adverbe court se glisse entre l'auxiliaire et le participe passé."
   }
  ],
  "why_it_matters": "Les adverbes de nuance (_probablement, nettement, notamment, désormais_) sont des marqueurs de niveau B2.",
  "exam_approach": {
   "look_first": [
    "ce que le mot modifie (nom ou verbe ?)",
    "la terminaison de l'adjectif (-ant, -ent ?)",
    "un temps composé"
   ],
   "traps": [
    "*_il parle bon français_",
    "*_évidamment_",
    "*_il a travaillé bien_"
   ],
   "distractors": [
    "l'adjectif à la place de l'adverbe",
    "_-amment / -emment_ inversés",
    "l'adverbe mal placé"
   ]
  }
 },
