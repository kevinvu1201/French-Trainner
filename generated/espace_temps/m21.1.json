 "learning": {
  "logic_chain": [
   {
    "stage": "assumption",
    "md": "L'origine se marque avec _de_, comme la destination avec _à / en / au_."
   },
   {
    "stage": "mechanism",
    "md": "Pays féminin → _de / d'_ sans article ; pays masculin → _du_ ; pays pluriel → _des_."
   },
   {
    "stage": "result",
    "md": "Les régions masculines se construisent souvent avec _dans le_."
   }
  ],
  "why_it_matters": "Présenter son parcours (_je viens de…, j'ai vécu en…_) ouvre l'épreuve orale du DELF.",
  "exam_approach": {
   "look_first": [
    "destination ou origine ?",
    "le genre et le nombre du lieu"
   ],
   "traps": [
    "*_je viens de la France_",
    "*_je viens de Japon_"
   ],
   "distractors": [
    "l'article gardé après _de_ devant un pays féminin",
    "_de_ sans article devant un pays masculin"
   ]
  }
 },
