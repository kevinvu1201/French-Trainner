{
 "module": "m37.1",
 "source_hash": "58f89227e2d5",
 "learning": {
  "logic_chain": [
   {
    "stage": "assumption",
    "md": "La préposition après un verbe n'est pas logique : elle appartient au verbe."
   },
   {
    "stage": "mechanism",
    "md": "On apprend chaque verbe avec sa construction : _penser à_, _parler de_, _décider de_, _réussir à_…"
   },
   {
    "stage": "result",
    "md": "La préposition détermine le pronom de reprise (_j'y pense, j'en parle_) et le relatif (_auquel, dont_)."
   }
  ],
  "why_it_matters": "Les constructions verbales correctes (_participer à, éviter de_) sont un critère de « richesse et correction » à l'écrit.",
  "exam_approach": {
   "look_first": [
    "le verbe principal",
    "nom ou infinitif après le verbe"
   ],
   "traps": [
    "*_participer dans_",
    "*_décider à partir_",
    "*_j'espère de réussir_"
   ],
   "distractors": [
    "la préposition de l'autre série",
    "une préposition calquée sur l'anglais"
   ]
  }
 },
 "connections": [],
 "questions": [
  {
   "id": "q.37.a.001",
   "los": "los.37.a",
   "difficulty": 1,
   "qtype": "form",
   "stem": "Elle participe …… un projet humanitaire.",
   "options": [
    "dans",
    "à",
    "de"
   ],
   "answer": "B",
   "explanations": {
    "A": "Faux. *_participer dans_ est un calque de l'anglais.",
    "B": "Correct. _participer à_.",
    "C": "Faux. _participer de_ a un autre sens (= relever de)."
   }
  },
