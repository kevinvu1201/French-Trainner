{
 "module": "m16.1",
 "source_hash": "e59fe7b8eb3c",
 "learning": {
  "logic_chain": [
   {
    "stage": "assumption",
    "md": "Tous les verbes en _-er_ (sauf _aller_) ont les mêmes terminaisons au présent."
   },
   {
    "stage": "mechanism",
    "md": "Le radical change d'orthographe pour garder la prononciation : _ç, ge, è, ll, tt, i_."
   },
   {
    "stage": "result",
    "md": "Ces changements touchent _je, tu, il, ils_ ; _nous_ et _vous_ restent réguliers."
   }
  ],
  "why_it_matters": "L'orthographe des verbes courants (_j'achète, nous commençons, il appelle_) est vérifiée dans toute production écrite.",
  "exam_approach": {
   "look_first": [
    "la terminaison de l'infinitif (-cer, -ger, -yer, -eler…)",
    "la personne (terminaison muette ou non ?)"
   ],
   "traps": [
    "*_nous mangons_",
    "*_j'achete_",
    "*_nous appellons_"
   ],
   "distractors": [
    "le radical non modifié",
    "la modification appliquée à _nous / vous_"
   ]
  }
 },
 "connections": [],
